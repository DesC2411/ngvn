# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Mật khẩu trang quản trị (bắt buộc ở production). Nên dài ≥ 16 ký tự ngẫu nhiên.
ADMIN_KEY=

# Cổng chạy server (trang + API + WebSocket chung một cổng)
PORT=8820

# Đứng sau nginx/Caddy trên cùng máy thì đặt true để lấy đúng IP học sinh (giới hạn tần suất theo IP).
# false | true (= tin 1 lớp proxy) | số lớp proxy | loopback
TRUST_PROXY=false

# development (gắn Vite, tự nạp lại) | production (phục vụ dist/ sau khi npm run build)
NODE_ENV=development

# (Tuỳ chọn) thư mục chứa db/ và uploads/. Mặc định: data/
# DATA_DIR=
